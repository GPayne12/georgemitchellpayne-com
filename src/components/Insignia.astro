---
/**
 * The learning-engineer insignia — the Practice Venn reduced to a mark.
 *
 * Geometry is deliberately identical to src/components/Venn.jsx (r=96 circles
 * at 155,158 / 245,158 / 200,238) so the brand mark and the interactive
 * diagram read as the same object. There are two viewBoxes:
 *   - default `52 50 296 296` — tightened to the circles, for use as a mark.
 *   - `labels` `0 0 400 386` — the Venn's own box, which reserves the margin
 *     the domain labels sit in.
 */
interface Props {
  /** Rendered edge length in px. The mark is square unless `labels` is set. */
  size?: number;
  /** Accessible name. Omit when the mark is decorative beside real text. */
  label?: string;
  /** Heavier strokes and denser fills, so the mark holds up when small. */
  dense?: boolean;
  /** Sit on the text baseline and scale with the font, for use in a sentence. */
  inline?: boolean;
  /**
   * Draw the Venn's domain and centre labels. The type is sized in user units,
   * so it only stays legible from roughly 400px wide up — do not set this on
   * the nav or inline marks.
   */
  labels?: boolean;
  class?: string;
}

const {
  size = 120,
  label,
  dense = false,
  inline = false,
  labels = false,
  class: className = '',
} = Astro.props;

const R = 96;
const CIRCLES = [
  { cx: 155, cy: 158, color: 'var(--color-ld)' },
  { cx: 245, cy: 158, color: 'var(--color-eng)' },
  { cx: 200, cy: 238, color: 'var(--color-gov)' },
];

/*
 * Copy, placement and type scale are taken verbatim from Venn.jsx's DOMAINS so
 * the homepage mark and the Practice diagram carry the same labels. Venn hard-
 * codes the hexes; here they stay as tokens, which resolve to the same values.
 */
const LABELS = [
  { lines: ['Learning', 'Design'],         color: 'var(--color-ld)',  x: 80,  y: 46 },
  { lines: ['Engineering', '& Building'],  color: 'var(--color-eng)', x: 320, y: 46 },
  { lines: ['Leadership', '& Governance'], color: 'var(--color-gov)', x: 200, y: 362 },
];

/*
 * The default (non-dense) values are lifted from Venn.jsx's resting state
 * (fillOpacity 0.07, strokeWidth 1.5, strokeOpacity 0.65) so a large mark is
 * indistinguishable from the interactive diagram. The scales line up too: the
 * Venn is a 400-unit viewBox drawn at ~424px (1.06), this is a 296-unit box
 * drawn at 310px (1.047), so an identical stroke-width lands within 0.1px.
 *
 * `dense` exists because those values disappear below ~40px.
 */
const fillOpacity = dense ? 0.3 : 0.07;
const strokeWidth = dense ? 8 : 1.5;
const strokeOpacity = dense ? 0.85 : 0.65;

/* Labelled, the box is the Venn's 400x386 and no longer square. */
const viewBox = labels ? '0 0 400 386' : '52 50 296 296';
const height = labels ? Math.round((size * 386) / 400) : size;
---

<svg
  class:list={['insignia', inline && 'is-inline', className]}
  viewBox={viewBox}
  width={size}
  height={height}
  role={label ? 'img' : undefined}
  aria-label={label}
  title={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  {
    CIRCLES.map(c => (
      <circle
        cx={c.cx}
        cy={c.cy}
        r={R}
        fill={c.color}
        fill-opacity={fillOpacity}
        stroke={c.color}
        stroke-opacity={strokeOpacity}
        stroke-width={strokeWidth}
      />
    ))
  }
  {
    labels && (
      <Fragment>
        {/* y must be explicit on the first tspan; without it the label defaults
            to y=0 and bleeds above the viewBox. */}
        {LABELS.map(l => (
          <text class="insignia-label" text-anchor="middle" fill={l.color}>
            <tspan x={l.x} y={l.y}>{l.lines[0]}</tspan>
            <tspan x={l.x} dy="15">{l.lines[1]}</tspan>
          </text>
        ))}
        <text class="insignia-center" text-anchor="middle">
          <tspan x={200} y={186}>learning</tspan>
          <tspan x={200} dy="14">engineer</tspan>
        </text>
      </Fragment>
    )
  }
</svg>

<style>
  .insignia {
    display: block;
    height: auto;
    max-width: 100%;
  }

  /* Named inside a sentence: sized in em so it tracks the surrounding type.
     The nudge centres the mark on the cap-height midline rather than the
     baseline. For the body serif that midline sits ~0.33em up, so a 1em mark
     needs its bottom edge 0.17em below the baseline (0.5em - 0.33em). */
  .insignia.is-inline {
    display: inline-block;
    width: 1em;
    height: 1em;
    vertical-align: -0.17em;
    margin-inline: 0.12em;
  }

  /* px inside an SVG resolves to user units, so these track the viewBox and
     match Venn.jsx's fontSize 11 / 10 exactly. */
  .insignia-label {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.03em;
  }

  .insignia-center {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.07em;
    fill: var(--color-ink);
  }
</style>
