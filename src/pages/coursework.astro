---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { curriculum } from '../data/curriculum';

const courses = await getCollection('coursework');

const total = courses.length;
const complete = courses.filter(c => c.data.status === 'complete');
const inProgress = courses.filter(c => c.data.status === 'in-progress');
const pct = total === 0 ? 0 : Math.round((complete.length / total) * 100);

const creditsEarned = complete.reduce((sum, c) => sum + (c.data.credits ?? 0), 0);

// Group by curriculum section, preserving each group's declared order.
const groups = [...new Map(
  courses.map(c => [c.data.group, { name: c.data.group, order: c.data.groupOrder }])
).values()]
  .sort((a, b) => a.order - b.order || a.name.localeCompare(b.name))
  .map(g => {
    const items = courses
      .filter(c => c.data.group === g.name)
      .sort((a, b) => a.data.order - b.data.order);
    return {
      ...g,
      items,
      done: items.filter(c => c.data.status === 'complete').length,
    };
  });

const statusLabel = {
  complete: 'complete',
  'in-progress': 'in progress',
  planned: 'not started',
} as const;

const dateFmt = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  year: 'numeric',
  timeZone: 'UTC',
});
---

<Layout
  title="Coursework — George Mitchell Payne"
  description={`Progress against the full ${curriculum.program} curriculum — ${complete.length} of ${total} concentrations complete.`}
>
  <div class="container">

    <section class="cw-header">
      <p class="telemetry section-label">// coursework</p>
      <h1 class="cw-title">{curriculum.program}</h1>
      {curriculum.institution && (
        <p class="cw-institution">{curriculum.institution}</p>
      )}
      <p class="cw-lead">{curriculum.blurb}</p>
    </section>

    <!-- ── Progress rail ──────────────────────────────── -->
    <section class="progress" aria-labelledby="progress-heading">
      <h2 id="progress-heading" class="visually-hidden">Curriculum progress</h2>

      <p class="progress-readout">
        <strong>{complete.length}</strong> of <strong>{total}</strong> concentrations complete
        <span class="progress-pct">({pct}%)</span>
      </p>

      <div class="progress-track" aria-hidden="true">
        <div class="progress-fill" style={`width: ${pct}%`}></div>
      </div>

      <ul class="progress-stats" role="list">
        {inProgress.length > 0 && (
          <li><span class="stat-num">{inProgress.length}</span> in progress</li>
        )}
        <li>
          <span class="stat-num">{total - complete.length - inProgress.length}</span> remaining
        </li>
        {curriculum.creditGoal > 0 && (
          <li>
            <span class="stat-num">{creditsEarned}</span> of {curriculum.creditGoal} credits
          </li>
        )}
      </ul>

      <ul class="milestones" role="list">
        {curriculum.milestones.map(m => (
          <li><span class="milestone-label">{m.label}</span> {m.date}</li>
        ))}
      </ul>
    </section>

    {total === 0 ? (
      <p class="cw-empty">Curriculum not loaded yet.</p>
    ) : (
      groups.map(group => (
        <section class="cw-group" aria-labelledby={`g-${group.order}`}>
          <div class="group-head">
            <h2 id={`g-${group.order}`} class="group-title">{group.name}</h2>
            <p class="telemetry group-count">
              {group.done}/{group.items.length}
            </p>
          </div>

          <ul class="course-list" role="list">
            {group.items.map(c => (
              <li class={`course course--${c.data.status}`}>

                <div class="course-mark">
                  {c.data.status === 'complete' && c.data.badge ? (
                    <Image
                      class="course-badge"
                      src={c.data.badge}
                      alt={c.data.badgeAlt ?? ''}
                      width={56}
                      height={56}
                      loading="lazy"
                    />
                  ) : (
                    <span class="course-dot" aria-hidden="true"></span>
                  )}
                </div>

                <div class="course-body">
                  <div class="course-title-row">
                    <span class="telemetry course-code">{c.data.code}</span>
                    <h3 class="course-name">{c.data.title}</h3>
                    <span class={`course-status status--${c.data.status}`}>
                      {statusLabel[c.data.status]}
                    </span>
                  </div>

                  <p class="course-meta">
                    {[
                      c.data.status === 'complete' && c.data.completedOn
                        ? dateFmt.format(c.data.completedOn)
                        : c.data.term,
                      c.data.credits ? `${c.data.credits} cr` : null,
                    ].filter(Boolean).join(' · ')}
                  </p>

                  <p class="course-summary">{c.data.summary}</p>

                  {c.data.courses.length > 0 && (
                    <details class="lessons">
                      <summary class="lessons-toggle">
                        {c.data.courses.length} courses
                        {c.data.assessment ? ` · ${c.data.assessment}` : ''}
                      </summary>
                      <ol class="lesson-list">
                        {c.data.courses.map(l => <li>{l}</li>)}
                      </ol>
                    </details>
                  )}

                  {c.data.status === 'complete' && c.data.reflection && (
                    <blockquote class="course-reflection">
                      <p class="telemetry reflection-label">// what it was worth</p>
                      <p class="reflection-body">{c.data.reflection}</p>
                    </blockquote>
                  )}

                  {c.data.skills.length > 0 && (
                    <ul class="skill-tags" role="list" aria-label="Skills">
                      {c.data.skills.map(s => <li class="skill-tag">{s}</li>)}
                    </ul>
                  )}

                  {c.data.status === 'complete' && (
                    <div class="course-links">
                      <a href={`/coursework/${c.data.slug}`} class="course-link">
                        detail →
                      </a>
                      {c.data.verifyUrl && (
                        <a
                          href={c.data.verifyUrl}
                          class="course-link"
                          rel="noopener noreferrer"
                          aria-label={`Verify the ${c.data.title} credential`}
                        >
                          verify credential →
                        </a>
                      )}
                    </div>
                  )}
                </div>

              </li>
            ))}
          </ul>
        </section>
      ))
    )}

  </div>
</Layout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  /* ── Header ───────────────────────────────────────── */
  .cw-header {
    padding-top: var(--space-4);
    margin-bottom: var(--space-8);
    max-width: var(--content-width);
  }

  .section-label {
    margin-bottom: var(--space-4);
  }

  .cw-title {
    font-size: var(--text-4xl);
    font-weight: 600;
    line-height: 1.1;
    margin-bottom: var(--space-2);
  }

  .cw-institution {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
    margin-bottom: var(--space-4);
  }

  .cw-lead {
    font-size: var(--text-lg);
    color: var(--color-ink-muted);
    line-height: 1.65;
    max-width: 52ch;
  }

  .cw-empty {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  /* ── Progress rail ────────────────────────────────── */
  .progress {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: var(--space-6);
    margin-bottom: var(--space-12);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .progress-readout {
    font-size: var(--text-lg);
    line-height: 1.3;
  }

  .progress-readout strong {
    font-weight: 600;
  }

  .progress-pct {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-ink-muted);
  }

  .progress-track {
    height: 6px;
    border-radius: 100px;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--color-telemetry);
    border-radius: 100px;
  }

  .progress-stats {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    letter-spacing: 0.02em;
  }

  .stat-num {
    color: var(--color-ink);
    font-weight: 600;
  }

  .milestones {
    list-style: none;
    padding: var(--space-3) 0 0;
    border-top: 1px solid var(--color-border);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink);
    letter-spacing: 0.02em;
  }

  .milestone-label {
    color: var(--color-ink-muted);
  }

  /* ── Lessons disclosure ───────────────────────────── */
  .lessons {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .lessons-toggle {
    cursor: pointer;
    color: var(--color-ink-muted);
    letter-spacing: 0.02em;
    padding: 0.15em 0;
  }

  .lessons-toggle:hover {
    color: var(--color-accent);
  }

  .lesson-list {
    margin: var(--space-3) 0 0 var(--space-5);
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    color: var(--color-ink-muted);
    line-height: 1.5;
  }

  /* ── Group ────────────────────────────────────────── */
  .cw-group {
    margin-bottom: var(--space-12);
  }

  .group-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .group-title {
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.2;
  }

  .group-count {
    font-size: var(--text-sm);
    white-space: nowrap;
  }

  /* ── Course row ───────────────────────────────────── */
  .course-list {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .course {
    display: grid;
    grid-template-columns: 56px minmax(0, 1fr);
    gap: var(--space-5);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 10px;
    padding: var(--space-5) var(--space-6);
  }

  /* Not-yet-taken rows recede — the curriculum is visible, not loud. */
  .course--planned {
    background: transparent;
    border-style: dashed;
  }

  .course--planned .course-name,
  .course--planned .course-summary {
    color: var(--color-ink-muted);
  }

  .course-mark {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 2px;
  }

  .course-badge {
    width: 56px;
    height: 56px;
    object-fit: contain;
  }

  .course-dot {
    width: 14px;
    height: 14px;
    margin-top: 6px;
    border-radius: 50%;
    border: 2px solid var(--color-border);
  }

  .course--in-progress .course-dot {
    border-color: var(--color-telemetry);
    background: color-mix(in srgb, var(--color-telemetry) 25%, transparent);
  }

  /* A finished course with no badge art yet still reads as finished. */
  .course--complete .course-dot {
    border-color: var(--color-telemetry);
    background: var(--color-telemetry);
  }

  .course-body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
  }

  .course-title-row {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    flex-wrap: wrap;
  }

  .course-code {
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
  }

  .course-name {
    font-size: var(--text-lg);
    font-weight: 600;
    line-height: 1.25;
  }

  .course-status {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    padding: 0.15em 0.6em;
    border-radius: 100px;
    white-space: nowrap;
    border: 1px solid var(--color-border);
    color: var(--color-ink-muted);
    background: var(--color-bg);
  }

  .status--complete {
    color: var(--color-telemetry);
    background: color-mix(in srgb, var(--color-telemetry) 10%, transparent);
    border-color: color-mix(in srgb, var(--color-telemetry) 25%, transparent);
  }

  .status--in-progress {
    color: var(--color-ld);
    background: var(--color-ld-wash);
    border-color: color-mix(in srgb, var(--color-ld) 25%, transparent);
  }

  .course-meta {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    letter-spacing: 0.02em;
  }

  .course-meta:empty {
    display: none;
  }

  .course-summary {
    font-size: var(--text-sm);
    line-height: 1.7;
  }

  /* ── Reflection ───────────────────────────────────── */
  .course-reflection {
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-left: 2px solid var(--color-telemetry);
    border-radius: 6px;
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .reflection-label {
    font-size: var(--text-xs);
    margin: 0;
  }

  .reflection-body {
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--color-ink-muted);
  }

  /* ── Tags & links ─────────────────────────────────── */
  .skill-tags {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .skill-tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--color-ink-muted);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    padding: 0.15em 0.55em;
    border-radius: 3px;
    letter-spacing: 0.02em;
  }

  .course-links {
    display: flex;
    gap: var(--space-6);
    flex-wrap: wrap;
  }

  .course-link {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    text-decoration: none;
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .course-link:hover {
    color: var(--color-accent-hover);
  }

  @media (max-width: 560px) {
    .course {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .course-mark {
      justify-content: flex-start;
    }
  }
</style>
