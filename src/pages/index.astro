---
import Layout from '../layouts/Layout.astro';
import NowBuilding from '../components/NowBuilding.tsx';
import Insignia from '../components/Insignia.astro';
import { positioningLead } from '../data/positioning.ts';
---

<Layout title="George Mitchell Payne — Learning Engineer" description="George Mitchell Payne — learning engineer building learning systems with code and AI.">

  <!-- ── Hero ───────────────────────────────────────── -->
  <section class="hero">
    <div class="container">
      <div class="hero-inner">
        <h1 class="font-display hero-headline">
          The learning engineer.
        </h1>
        <p class="hero-body">
          {positioningLead} I have been building learning solutions
          for a decade. Now I build them with code and AI.
        </p>
        <Insignia
          labels
          size={420}
          class="hero-insignia"
          label="Three-circle Venn diagram: Learning Design, Engineering & Building, and Leadership & Governance, with 'learning engineer' at the center intersection."
        />
      </div>
    </div>
  </section>

  <!-- ── Audience doors ────────────────────────────── -->
  <section class="doors" aria-label="Explore by audience">
    <div class="container">
      <div class="doors-grid">

        <a href="/builds" class="door" aria-label="Explore builds — for engineering reviewers">
          <p class="telemetry door-label">// for AI + engineering reviewers</p>
          <h2 class="door-heading">Builds</h2>
          <p class="door-body">
            Every year for the last four years, I have woven AI into the practice of
            learning design. My tools may be limited in my 9-5, but my GitHub tells
            another story.
          </p>
          <span class="door-cta" aria-hidden="true">View builds →</span>
        </a>

        <a href="/practice" class="door" aria-label="Explore practice — for L&D leadership">
          <p class="telemetry door-label">// for L&D leadership</p>
          <h2 class="door-heading">Practice</h2>
          <p class="door-body">
            Ten years of learning design practice come down to two things: building
            custom, scalable learning solutions that ship end-to-end, and managing
            the learning ecosystems that sustain them.
          </p>
          <span class="door-cta" aria-hidden="true">View practice →</span>
        </a>

      </div>
    </div>
  </section>

  <!-- ── Now building — live GitHub telemetry ── -->
  <section class="now-building" aria-label="Now building">
    <div class="container">
      <p class="telemetry now-label">// now building</p>
      <NowBuilding client:load />
    </div>
  </section>

</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────── */
  .hero {
    padding-top: var(--space-20);
    padding-bottom: var(--space-16);
    border-bottom: 1px solid var(--color-border);
  }

  /* Same two columns and gap as .doors-grid below, so column 2 is exactly the
     Practice card's column and the mark can centre over it. No max-width, or
     the tracks would stop matching. */
  .hero-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: var(--space-6);
  }

  /* Spans both columns: at --text-5xl (60px) the headline needs ~660px and a
     single column is only ~540px, so confining it here would wrap it. */
  .hero-headline {
    grid-column: 1 / -1;
    grid-row: 1;
    max-width: 44rem;
  }

  .hero-body {
    grid-column: 1;
    grid-row: 2;
  }

  /* The mark occupies column 2 across both rows, so it can ride up alongside
     the headline. Before it carried labels its top edge sat on the headline's
     optical centre, but the domain labels are type, and type set level with the
     headline reads as a second column of the same sentence. So the anchor is
     now the headline's line box (--text-5xl x 1.05) plus a gap: the labels
     start below the headline's descenders, not beside them.

     The subtraction is the mark's own internal padding. The labelled viewBox is
     400x386 and the "Learning Design" cap line tops out around y=38, so ~0.095
     of the width sits empty above anything visible and has to come back out or
     the gap would read as ~40px larger than it is. 420px on the 400-unit box is
     scale 1.05, which keeps the circles at the same ~311px they rendered at
     before the labels were added. */
  :global(.hero-insignia) {
    grid-column: 2;
    grid-row: 1 / span 2;
    justify-self: center;
    align-self: start;
    margin-top: calc(var(--text-5xl) * 1.05 + var(--space-6) - 420px * 0.095);
  }

  .hero-headline {
    font-size: var(--text-5xl);
    line-height: 1.05;
    margin-bottom: var(--space-8);
  }

  .hero-body {
    font-size: var(--text-lg);
    line-height: 1.75;
    color: var(--color-ink);
    max-width: 38rem;
  }

  /* ── Doors ────────────────────────────────────────── */
  .doors {
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-border);
  }

  .doors-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .door {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-8);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    text-decoration: none;
    color: var(--color-ink);
    transition: border-color var(--duration-base) var(--ease-standard),
                background var(--duration-base) var(--ease-standard);
  }

  .door:hover {
    border-color: var(--color-accent);
    background: var(--color-bg);
  }

  .door-label {
    font-size: var(--text-xs);
  }

  .door-heading {
    font-size: var(--text-2xl);
    font-weight: 600;
    line-height: 1.2;
    margin: 0;
  }

  .door-body {
    font-size: var(--text-base);
    line-height: 1.65;
    color: var(--color-ink-muted);
    flex: 1;
  }

  .door-cta {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--color-accent);
    margin-top: var(--space-2);
    transition: color var(--duration-fast) var(--ease-standard);
  }

  .door:hover .door-cta {
    color: var(--color-accent-hover);
  }

  /* The mark drops below the paragraph, aligned to the text edge; the headline
     overlap is desktop-only, so the offset is cleared here. This breaks earlier
     than the doors below because the labels are sized in viewBox units: they
     stay legible down to ~380px of mark, and the hero's column 2 only clears
     that above ~56em of viewport. */
  @media (max-width: 56em) {
    .hero-inner {
      grid-template-columns: 1fr;
    }

    .hero-headline {
      grid-column: 1;
    }

    /* Capped via `width`, not `max-width`: the component's own scoped
       `.insignia` rule carries an astro-cid and so outspecifies a max-width
       set from here. */
    :global(.hero-insignia) {
      grid-column: 1;
      grid-row: 3;
      width: min(380px, 100%);
      justify-self: start;
      margin-top: var(--space-8);
    }
  }

  @media (max-width: 40em) {
    .doors-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ── Now building ─────────────────────────────────── */
  .now-building {
    padding-block: var(--space-8);
  }

  .now-label {
    margin-bottom: var(--space-2);
  }
</style>
